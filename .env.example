# Host-specific settings. Copied to .env on the Pi by bootstrap.sh.
# .env is gitignored — never commit it. Put secrets here, not in compose files.

TZ=Etc/UTC

# User/group the containers run as (check with `id` on the Pi).
PUID=1000
PGID=1000

# Persistent app state (databases, config). Back this up.
DATA_ROOT=/srv/appdata

# Media library (e.g. a mounted USB drive).
MEDIA_ROOT=/srv/media

# Pi-hole admin UI password (Pi-hole won't start until this is set).
PIHOLE_PASSWORD=

# Hostname used in dashboard links (defaults to the Pi's hostname).
#PI_HOST=

# Nextcloud (lives on the encrypted USB; see scripts/secure-usb.sh).
# Admin login is created on first start with these values.
#NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
